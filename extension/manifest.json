{
  "manifest_version": 3,
  "name": "VoiceScroll Ultimate",
  "version": "25.0.0",
  "description": "Pin-accurate hands-free voice scrolling for webpages and PDFs. Fuzzy matching, quantifiers, precision glide, auto-scroll.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-voice-scroll": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Toggle VoiceScroll listening"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
