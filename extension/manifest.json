{
  "manifest_version": 3,
  "name": "VoiceScroll Ultimate",
  "version": "26.0.0",
  "description": "Hands-free voice scrolling for any website, embedded files and native PDFs in Chrome & Edge. Works on pages extensions normally cannot touch via a voice hub + trusted input events.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vs-core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-voice-scroll": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Toggle VoiceScroll listening"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
